# --- Secrets / environment - NEVER commit these ---
.env
.env.*
!.env.example
**/.dlt/secrets.toml

# --- Python ---
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/

# --- Warehouse / generated data ---
# The DuckDB file is a BUILD ARTIFACT, regenerated by running the
# ingestion + dbt pipeline - committing it would mean tracking a binary
# blob that changes every run and grows the repo forever for no benefit.
*.duckdb
*.duckdb.wal
raw/

# --- dbt ---
transform/target/
transform/logs/
transform/dbt_packages/
transform/.user.yml

# --- Dagster ---
orchestration/**/.tmp_dagster_home_*/
orchestration/**/storage/
*.dagster_home/

# --- Node / Next.js ---
web/node_modules/
web/.next/
web/out/
web/.vercel/
*.tsbuildinfo
npm-debug.log*

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- NOT ignored, on purpose ---
# web/public/data/*.json (ph_detail.json, country_comparison.json,
# metadata.json, ph_zones.json) ARE committed. This is a static-export
# architecture - the site has no live backend, so these files being IN
# the repo is what makes the deployed site actually have data. They get
# regenerated and re-committed after each pipeline run, same as any
# other content update to a static site.